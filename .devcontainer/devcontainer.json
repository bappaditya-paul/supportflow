{
  "name": "SupportFlow - Flip the Switch Hackathon",
  "image": "mcr.microsoft.com/devcontainers/universal:latest",
  "forwardPorts": [5173, 8000, 34079],
  "portsAttributes": {
    "5173": {
      "label": "SupportFlow Client",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "cd client && npm install && cd ../server && pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
